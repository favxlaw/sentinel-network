[Unit]
Description=Sentinel Aggregator API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/sentinel/sentinel-network/aggregator
Environment="SERVICE_CONFIG_PATH=/opt/sentinel/sentinel-network/config/services.yaml"
Environment="TENANT_CONFIG_PATH=/opt/sentinel/sentinel-network/config/tenants.yaml"
EnvironmentFile=/etc/sentinel/sentinel.env
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/sentinel/sentinel-network/aggregator/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
