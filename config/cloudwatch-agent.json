{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "Sentinel/Backend",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/", "/data"],
        "metrics_collection_interval": 60
      },
      "netstat": {
        "measurement": ["tcp_established", "tcp_time_wait"],
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "/sentinel/system",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "/sentinel/cloud-init",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/opt/sentinel/sentinel-network/blockchain-proxy/logs/*.log",
            "log_group_name": "/sentinel/blockchain-proxy",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/opt/sentinel/sentinel-network/watcher-service/logs/*.log",
            "log_group_name": "/sentinel/watcher",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
