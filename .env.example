# Sentinel Network - Shared Environment Variables
# Copy to .env and set real values. Services also read config/services.yaml.

# Config locations
SERVICE_CONFIG_PATH=/opt/sentinel/sentinel-network/config/services.yaml
TENANT_CONFIG_PATH=/opt/sentinel/sentinel-network/config/tenants.yaml
SENTINEL_DB_PATH=/data/sentinel/watcher.db

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Blockchain RPC (proxy upstream)
UPSTREAM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
RPC_PROVIDER=alchemy
ALCHEMY_API_KEY=your-alchemy-key
INFURA_API_KEY=your-infura-key

# Proxy cache (optional)
REDIS_URL=redis://localhost:6379/0

# IPFS
IPFS_API_URL=http://127.0.0.1:5001

# Tenant API keys
DAO_ALPHA_API_KEY=change-me-alpha
DAO_BETA_API_KEY=change-me-beta
DAO_GAMMA_API_KEY=change-me-gamma
