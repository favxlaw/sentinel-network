[Unit]
Description=Sentinel Network - Blockchain Proxy Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sentinel-network/services/blockchain-proxy
Environment="PATH=/home/ubuntu/sentinel-network/services/blockchain-proxy/venv/bin"
EnvironmentFile=/home/ubuntu/sentinel-network/services/blockchain-proxy/.env
ExecStart=/home/ubuntu/sentinel-network/services/blockchain-proxy/venv/bin/gunicorn \
    --bind 0.0.0.0:5000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /var/log/sentinel/proxy-access.log \
    --error-logfile /var/log/sentinel/proxy-error.log \
    app:app

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target