# Aggregator API Configuration
# Copy this to .env and fill in your actual values

# Database
SENTINEL_DB_PATH=../watcher-service/watcher.db

# Tenant Config
TENANT_CONFIG_PATH=../watcher-service/config/tenants.yaml

# API Server
API_HOST=127.0.0.1
API_PORT=8006

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# IPFS
IPFS_HOST=localhost
IPFS_PORT=5001
