#!/bin/bash
set -euo pipefail

PRIVATE_CIDR="${private_cidr}"

# Detect primary network interface dynamically
IFACE=$(ip route get 8.8.8.8 | awk '{print $5; exit}')

apt-get update -y

echo "iptables-persistent iptables-persistent/autosave_v4 boolean false" | debconf-set-selections
echo "iptables-persistent iptables-persistent/autosave_v6 boolean false" | debconf-set-selections
DEBIAN_FRONTEND=noninteractive apt-get install -y iptables-persistent

sysctl -w net.ipv4.ip_forward=1
if ! grep -q "net.ipv4.ip_forward=1" /etc/sysctl.conf; then
  echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
fi

iptables -t nat -A POSTROUTING -s "$${PRIVATE_CIDR}" -o "$IFACE" -j MASQUERADE
iptables -A FORWARD -s "$${PRIVATE_CIDR}" -o "$IFACE" -j ACCEPT
iptables -A FORWARD -d "$${PRIVATE_CIDR}" -m state --state ESTABLISHED,RELATED -i "$IFACE" -j ACCEPT

netfilter-persistent save

systemctl enable snap.amazon-ssm-agent.amazon-ssm-agent
systemctl start snap.amazon-ssm-agent.amazon-ssm-agent


# Install CloudWatch agent
curl -sO https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
dpkg -i amazon-cloudwatch-agent.deb
rm amazon-cloudwatch-agent.deb

# Configure CloudWatch agent for NAT instance
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF_CW'
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "Sentinel/NAT",
    "metrics_collected": {
      "cpu": {
        "measurement": ["cpu_usage_idle"],
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "net": {
        "measurement": ["net_bytes_sent", "net_bytes_recv"],
        "resources": ["ens5"],
        "metrics_collection_interval": 60
      }
    }
  }
}
EOF_CW

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

systemctl enable amazon-cloudwatch-agent
systemctl start amazon-cloudwatch-agent